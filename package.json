{
  "name": "aegis-vault",
  "productName": "Aegis",
  "version": "1.0.4",
  "description": "Aegis — a liquid-glass desktop vault for passwords, API keys and secrets.",
  "private": true,
  "main": "electron/main.cjs",
  "author": "Aegis",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/AadritIND/Aegis.git"
  },
  "scripts": {
    "dev": "concurrently -k -n VITE,APP -c cyan,magenta \"vite --port 5273 --strictPort\" \"wait-on tcp:5273 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5273 electron .\"",
    "dev:web": "vite --port 5273 --strictPort",
    "build": "tsc --noEmit && vite build",
    "start": "electron .",
    "dist": "npm run build && electron-builder --win",
    "dist:dir": "npm run build && electron-builder --win --dir",
    "dist:linux": "npm run build && electron-builder --linux",
    "dist:linux:dir": "npm run build && electron-builder --linux --dir",
    "dist:mac": "npm run build && python scripts/build-mac.py --copy-to-site",
    "dist:mac:signed": "npm run build && electron-builder --mac"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "electron-updater": "^6.8.11",
    "framer-motion": "^11.15.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.1.1",
    "@fontsource-variable/jetbrains-mono": "^5.1.2",
    "@fontsource-variable/sora": "^5.1.1",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "app.aegis.vault",
    "productName": "Aegis",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "publish": {
      "provider": "github",
      "owner": "AadritIND",
      "repo": "Aegis",
      "releaseType": "draft"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "Aegis-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Aegis"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "artifactName": "Aegis-mac-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icon.png",
      "category": "Utility;Security",
      "executableName": "aegis",
      "artifactName": "Aegis-Linux-x86_64.${ext}",
      "maintainer": "Aegis <AadritIND@users.noreply.github.com>",
      "vendor": "Aegis",
      "synopsis": "Local-first encrypted password and secret vault",
      "description": "Aegis keeps passwords, API keys, cards and secure notes in one AES-256-GCM encrypted vault on your own machine.",
      "desktop": {
        "Name": "Aegis",
        "Comment": "Local-first encrypted password and secret vault",
        "Keywords": "password;vault;secrets;security;encryption;",
        "StartupWMClass": "Aegis"
      }
    }
  }
}
