{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/dl/windows",
      "destination": "https://github.com/AadritIND/Aegis/releases/latest/download/Aegis-Setup.exe"
    },
    {
      "source": "/dl/mac-zip",
      "destination": "https://github.com/AadritIND/Aegis/releases/latest/download/Aegis-mac-universal.zip"
    },
    {
      "source": "/dl/mac-dmg",
      "destination": "https://github.com/AadritIND/Aegis/releases/latest/download/Aegis-mac-universal.dmg"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
